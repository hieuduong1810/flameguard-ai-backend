flowchart TB
  subgraph frame["D09 — EXPERIMENT EXPLORER + COMPARISON MODAL | Must / Should"]
    direction TB
    open(["Open Explorer /explorer"])
    filters["Search + purpose + fuel + source filters [M]"]
    catalog[("INVESTIGATION + TAG + SOURCE_DOCUMENT")]
    results["Catalog rows + evidence status [M]"]
    mode{"Comparison mode enabled?"}
