APP_NAME="FlameGuard AI Backend"
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Local development examples only. Keep DATABASE_URL and POSTGRES_* synchronized.
# Percent-encode special characters in URL credentials.
DATABASE_URL=postgresql+asyncpg://flameguard:local-development-only@localhost:5432/flameguard
CORS_ORIGINS=["http://localhost:3000","https://flame-in-freewall-tourbillion.vercel.app"]
DB_CONNECT_TIMEOUT_SECONDS=3
DB_READY_TIMEOUT_SECONDS=3
POSTGRES_USER=flameguard
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=flameguard
POSTGRES_PORT=5432
