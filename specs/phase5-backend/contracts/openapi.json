{
  "openapi": "3.1.0",
  "info": {
    "title": "FlameGuard AI Backend",
    "description": "Research demonstration backend. Not operational spacecraft fire safety advice.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/mission/scenarios/evaluate": {
      "post": {
        "tags": [
          "mission"
        ],
        "summary": "Evaluate Mission Scenario",
        "description": "Inspect scoped evidence for a mission scenario using available providers.",
        "operationId": "evaluateMissionScenario",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluation"
                }
              }
            }
          },
          "409": {
            "description": "Continuation bindings changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid scenario evaluation request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationError"
                }
              }
            }
          },
          "503": {
            "description": "Evidence collection unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationError"
                }
              }
            }
          }
        }
      }
    }
  },
